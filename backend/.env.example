# AI-Powered Root Cause Analysis (RCA) Module Configuration

# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supported Models:
# - llama-3.3-70b-versatile (Recommended for deep pharma analysis & reasoning)
# - gemma2-9b-it (Fast & compliant extraction)
# - llama-3.1-8b-instant (Ultra-low latency)
# - mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
# Supports SQLite (default, zero-setup), PostgreSQL, and MySQL
# SQLite: sqlite:///./rca_pharma.db
# PostgreSQL: postgresql://user:password@localhost:5432/pharma_rca
# MySQL: mysql+pymysql://user:password@localhost:3306/pharma_rca
DATABASE_URL=sqlite:///./rca_pharma.db

# Application Configuration
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Constraints
MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,txt
